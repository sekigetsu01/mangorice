# gcl NAME: your GitHub repo NAME into ~/github/NAME, replacing what's there; also gcl user/repo or a full URL
_gcl_user() { command head -n1 -- "${XDG_STATE_HOME:-$HOME/.local/state}/update-dotfiles/usernames" 2>/dev/null; }
gcl() {
	[ -n "${1-}" ] || { echo "Usage: gcl repo | user/repo | url" >&2; return 1; }
	local src=$1 user name dest; shift
	case $src in
	*://*|git@*) ;;
	*/*) src=https://github.com/$src ;;
	*) user=$(_gcl_user)
	   [ -n "$user" ] || { echo "gcl: don't know your GitHub name yet (ud learns it); use gcl user/repo" >&2; return 1; }
	   src=https://github.com/$user/$src ;;
	esac
	name=${${src%/}##*/}; name=${name%.git}; dest=$HOME/github/$name
	command mkdir -p -- ~/github
	command rm -rf -- "$dest.new"
	GIT_TERMINAL_PROMPT=0 git clone "$@" -- "$src" "$dest.new" ||
		{ command rm -rf -- "$dest.new"; echo "gcl: couldn't clone $src (no such repo, or it's private)" >&2; return 1; }
	command rm -rf -- "$dest" && command mv -f -- "$dest.new" "$dest" && echo "~/github/$name"
}


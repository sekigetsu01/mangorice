unalias ls rm y 2>/dev/null

ls() {
	local arg prev='' eza='' gnu=''
	for arg in "$@"; do
		case "$prev" in
			--time|--time-style) arg=$prev=$arg ;;
		esac
		prev=$arg
		case "$arg" in
			--) break ;;
			--absolute*|--accessed|--across|--binary|--blocksize|--bytes|--changed|--code|--color-scale*|--colour-scale*|\
			--created|--extended|--flags|--follow-symlinks|--git*|--grid|--group|--group-directories-last|\
			--header|--icons*|--ignore-glob*|--level*|--links|--loc|--long|--modified|--mounts|--no-filesize|\
			--no-git|--no-icons|--no-permissions|--no-quotes|--no-symlinks|--no-time|--no-user|--numeric|\
			--octal-permissions|--oneline|--only-dirs|--only-files|--recurse|--short-nix|--show-symlinks|\
			--smart-group|--stdin|--total-size|--treat-dirs-as-files|--tree) eza=1 ;;
			--time-style=relative|--time-style=default|--time=modified|--time=accessed|--time=changed|--time=created) eza=1 ;;
			--sort=version|--sort=width|--time-style=locale|--time-style=posix-*) gnu=1 ;;
			--all|--almost-all|--classify*|--colo*r*|--context|--dereference|--group-directories-first|\
			--help|--hyperlink*|--inode|--reverse|--sort*|--time-style*|--version|--width*) ;;
			--*) gnu=1 ;;
			-*[TD@M]*) eza=1 ;;
			-*[thSXcuUvsmkNQpqLCgofGBHb]*) gnu=1 ;;
		esac
	done
	if [ -n "$gnu" ] && [ -z "$eza" ]; then
		command ls --color=auto "$@"
	else
		eza --icons --group-directories-first "$@"
	fi
}

rm() {
	local arg a r=''
	for arg; do
		shift
		a=${arg%"${arg##*[!/]}"}
		[ -n "$a" ] && [ -L "$a" ] && arg=$a
		[ -d "$arg" ] && [ ! -L "$arg" ] && r=-r
		set -- "$@" "$arg"
	done
	command rm $r -f -v "$@"
}

mkcd() { mkdir -p -- "$1" && cd -- "$1" || return; }


y() {
	local tmp cwd
	tmp=$(mktemp -t yazi-cwd.XXXXXX) || return
	yazi "$@" --cwd-file="$tmp"
	cwd=$(<$tmp)
	command rm -f -- "$tmp"
	[[ $cwd == search://*//* ]] && cwd=/${cwd#search://*//}
	[[ -d $cwd && $cwd != "$PWD" ]] && cd -- "$cwd"
	return 0
}
alias l=y

if command -v fzf >/dev/null 2>&1; then
	export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git --exclude node_modules'
	export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git --exclude node_modules'
	export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
	export FZF_ALT_C_OPTS='--preview "eza --icons --color=always {}"'
	export FZF_CTRL_R_OPTS='--preview "echo {}" --preview-window=down:3:wrap'

	_walfzf() {
		local f="${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors" now=''
		[[ -r $f ]] && now=$(<$f)
		[[ $now == "${_walfzf_seen-x}" ]] && return
		_walfzf_seen=$now
		local -a c
		[[ -n $now ]] && c=( "${(@f)now}" )
		export FZF_DEFAULT_OPTS="--height=40% --layout=reverse --border=rounded --prompt='❯ ' --pointer='▶'${c[16]:+ --color=fg:$c[8],fg+:$c[16],bg+:$c[9],hl:$c[2],hl+:$c[2],info:$c[4],prompt:$c[5],pointer:$c[6],marker:$c[3],spinner:$c[7],header:$c[5],border:$c[9]}"
	}
	_walfzf
	autoload -Uz add-zsh-hook
	add-zsh-hook precmd _walfzf

	_zcache fzf fzf --zsh
fi

_dirs="${XDG_CONFIG_HOME:-$HOME/.config}/shell/dirs"
if [ -r "$_dirs" ]; then
	while read -r _a _k _m _p; do
		case $_p in "~"*) _p=$HOME${_p#"~"} ;; esac
		[ -n "$_a" ] && [ "$_a" != - ] && alias "$_a=$_m \"$_p\""
	done < "$_dirs"
fi
unset _dirs _a _k _m _p


#!/bin/sh
# SUPER+F9: open the guide to this system (System Guide.pdf in ~/sync/documents) in sioyek
# guide build: remake the PDF from its source, ~/sync/documents/.system-guide/guide.md
d=$HOME/sync/documents
if [ "${1:-}" = build ]; then
    exec uv run -q --no-project --with reportlab python "$d/.system-guide/build.py"
fi
f="$d/System Guide.pdf"
[ -f "$f" ] || f=$(find "$d" -maxdepth 1 -iname '*guide*.pdf' 2>/dev/null | head -n 1)
if [ -n "$f" ] && [ -f "$f" ]; then
    command -v sioyek >/dev/null && exec sioyek --new-window "$f"
    exec xdg-open "$f"
fi
notify-send --app-name=Guide "No guide found" "Put System Guide.pdf in ~/sync/documents"
